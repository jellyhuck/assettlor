{
  "name": "assettlor",
  "version": "1.0.0",
  "description": "High-performance local-first game asset manager and web viewer",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"cyan,magenta\" \"tsx watch server/src/index.ts --config ./sample/config.yaml\" \"npm --prefix client run dev\"",
    "dev:server": "tsx watch server/src/index.ts --config ./sample/config.yaml",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "typecheck:server": "tsc --noEmit",
    "verify": "npm test && npm --prefix client run lint && npm run build && npm run typecheck:server",
    "start": "tsx server/src/index.ts",
    "generate:samples": "tsx scripts/generate-sample-assets.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:pipeline": "node --import tsx scripts/test-pipeline.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.5",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "adm-zip": "^0.6.1",
    "audio-decode": "^3.12.0",
    "better-sqlite3": "^13.0.3",
    "bmp-js": "^0.1.0",
    "bytes": "^3.1.2",
    "concurrently": "^10.0.5",
    "dotenv": "^18.0.5",
    "fastify": "^5.12.5",
    "liqe": "^3.8.7",
    "music-metadata": "^12.0.0",
    "music-tempo": "^1.0.3",
    "sharp": "^0.35.5",
    "tga-js": "^1.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/bytes": "^3.1.6",
    "@vitest/coverage-v8": "^5.0.3",
    "vitest": "^5.0.3"
  }
}
