{
  "name": "assettlor",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Local-first asset manager for images, audio, and asset libraries",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jellyhuck/assettlor.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "assettlor": "bin/assettlor.js"
  },
  "files": [
    "bin/",
    "server/src/",
    "shared/",
    "client/dist/",
    "/tsconfig.json"
  ],
  "scripts": {
    "prepare": "npm --prefix client ci && npm run build",
    "dev": "concurrently -n \"server,client\" -c \"cyan,magenta\" \"tsx watch server/src/index.ts --config ./sample/config.yaml\" \"npm --prefix client run dev\"",
    "dev:server": "tsx watch server/src/index.ts --config ./sample/config.yaml",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "typecheck:server": "tsc --noEmit",
    "verify": "npm test && npm --prefix client run lint && npm run build && npm run typecheck:server",
    "start": "tsx server/src/index.ts",
    "generate:samples": "tsx scripts/generate-sample-assets.ts",
    "docs": "tsx scripts/docs.ts",
    "docs:build": "tsx scripts/docs.ts build --strict",
    "test": "vitest run",
    "test:client": "vitest run tests/client*.test.ts* tests/*.ui.test.ts* tests/classifierModalData.test.ts tests/dialogFocus.test.ts tests/settingsDraft.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:pipeline": "node --import tsx scripts/test-pipeline.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.5",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/yauzl": "^3.4.0",
    "adm-zip": "^0.6.1",
    "audio-decode": "^3.12.0",
    "better-sqlite3": "^13.0.3",
    "bmp-js": "^0.1.0",
    "bytes": "^3.1.2",
    "dotenv": "^18.0.5",
    "fastify": "^5.12.5",
    "liqe": "^3.8.7",
    "music-metadata": "^12.0.0",
    "music-tempo": "^1.0.3",
    "sharp": "^0.35.5",
    "tga-js": "^1.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/bytes": "^3.1.6",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.6",
    "jsdom": "^26.1.0",
    "vitest": "^5.0.3"
  }
}
